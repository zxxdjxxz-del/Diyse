    stage.add_child(enemy_zone)
    enemy_box = VBoxContainer.new()
    enemy_box.add_theme_constant_override("separation", 7)
    enemy_zone.add_child(enemy_box)

    var command_panel := PanelContainer.new()
    command_panel.custom_minimum_size = Vector2(0, 235)
    command_panel.add_theme_stylebox_override("panel", _panel_style(COLOR_PANEL, COLOR_GOLD, 10, 2))
    root.add_child(command_panel)

    var command_margin := MarginContainer.new()
    command_margin.add_theme_constant_override("margin_left", 16)
    command_margin.add_theme_constant_override("margin_right", 16)
    command_margin.add_theme_constant_override("margin_top", 10)
    command_margin.add_theme_constant_override("margin_bottom", 10)
    command_panel.add_child(command_margin)

    var command_root := VBoxContainer.new()
    command_root.add_theme_constant_override("separation", 8)
    command_margin.add_child(command_root)

    plan_label = Label.new()
    plan_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    plan_label.add_theme_font_size_override("font_size", 20)
    plan_label.add_theme_color_override("font_color", COLOR_TEXT)
    command_root.add_child(plan_label)

    var command_row := HBoxContainer.new()
    command_row.size_flags_vertical = Control.SIZE_EXPAND_FILL
    command_row.add_theme_constant_override("separation", 12)
    command_root.add_child(command_row)

    command_box = GridContainer.new()
    command_box.columns = 3
    command_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    command_box.add_theme_constant_override("h_separation", 9)
    command_box.add_theme_constant_override("v_separation", 9)
    command_row.add_child(command_box)

    var detail_scroll := ScrollContainer.new()
    detail_scroll.custom_minimum_size = Vector2(420, 0)
    detail_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
    detail_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
    command_row.add_child(detail_scroll)

    detail_box = VBoxContainer.new()
    detail_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    detail_box.add_theme_constant_override("separation", 7)
    detail_scroll.add_child(detail_box)

    confirm_button = Button.new()
    confirm_button.text = "CONFIRM ROUND"
    confirm_button.custom_minimum_size = Vector2(0, 62)
    confirm_button.add_theme_font_size_override("font_size", 21)
    confirm_button.visible = false
    confirm_button.pressed.connect(_confirm_round)
    command_root.add_child(confirm_button)

func _panel_style(fill: Color, border: Color, radius: int, border_width: int) -> StyleBoxFlat:
    var style := StyleBoxFlat.new()
    style.bg_color = fill
    style.border_color = border
    style.set_border_width_all(border_width)
    style.set_corner_radius_all(radius)
    return style

func _refresh_all() -> void:
    round_label.text = "%s · Round %d · %s" % [BattleContext.battle_kind.capitalize(), sim.round_number, phase.capitalize()]
    inventory_label.text = "Field Salve ×%d   ·   Triage ×%d" % [int(GameState.inventory.get("ITM_FIELD_SALVE", 0)), int(GameState.inventory.get("ITM_COMPANY_TRIAGE_KIT", 0))]
    _refresh_actor_panels()
    _refresh_plan_label()

func _refresh_actor_panels() -> void:
    _clear(status_box)
    var heading := Label.new()
    heading.text = "PARTY FORMATION"
    heading.add_theme_font_size_override("font_size", 21)
    heading.add_theme_color_override("font_color", COLOR_PARTY)
    status_box.add_child(heading)

    for id in sim.party_ids:
        var actor: Dictionary = sim.actor(id)
        var selected := current_party_index < planning_ids.size() and id == planning_ids[current_party_index] and phase == "PLANNING"
        status_box.add_child(_actor_card(actor, true, selected))

    _clear(enemy_box)
    var enemy_heading := Label.new()
    enemy_heading.text = "ENEMY FORMATION"
    enemy_heading.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
    enemy_heading.add_theme_font_size_override("font_size", 21)
    enemy_heading.add_theme_color_override("font_color", COLOR_ENEMY)
    enemy_box.add_child(enemy_heading)

    for id in sim.enemy_ids:
        var actor: Dictionary = sim.actor(id)
